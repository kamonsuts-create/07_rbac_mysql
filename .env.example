# ==============================================================================
# PLUK RAK (ปลูกรัก) - ตลาดผลผลิตเกษตรชุมชนส่งตรงจากสวน
# ENVIRONMENT CONFIGURATION FOR LOCAL & CLOUD PRODUCTION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL / TiDB Cloud / Railway / Aiven)
# ------------------------------------------------------------------------------
# [แนะนำสำหรับการขึ้นออนไลน์บน Vercel / Railway / Render]
# ใช้ DATABASE_URL เพียงบรรทัดเดียว (รองรับทั้ง TiDB Cloud, Aiven, Railway, AWS RDS):
# ตัวอย่าง TiDB Cloud Serverless (SSL อัตโนมัติ):
# DATABASE_URL="mysql://<user>.<prefix>:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/rbac_mysql?ssl={"rejectUnauthorized":true}"
DATABASE_URL=

# หรือแยกตามตัวแปรมาตรฐาน (สำหรับ Local MySQL):
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=12345678
DB_DATABASE=rbac_mysql
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT SESSION)
# ------------------------------------------------------------------------------
# คีย์ความลับสำหรับเข้ารหัส Cookie Token (ต้องมีความยาวอย่างน้อย 32 ตัวอักษร)
JWT_SECRET=c3d7eb8d1e6d118961b1b7f7d03365756a89399bf129ca2ad347376a8ee24739

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (สำหรับจัดเก็บรูปภาพสินค้าจริงและสลิปโอนเงินบนคลาวด์)
# ------------------------------------------------------------------------------
# สมัครฟรีที่ https://cloudinary.com
CLOUDINARY_CLOUD_NAME=of6fmiyb
CLOUDINARY_API_KEY=868871672887885
CLOUDINARY_API_SECRET=IFLeB6jG3jXB8bW_sx2BEwFlEEE

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (เข้าสู่ระบบด้วย Google)
# ------------------------------------------------------------------------------
# สมัครที่ Google Cloud Console: https://console.cloud.google.com/apis/credentials
# เมื่อนำเว็บขึ้นออนไลน์ ให้เปลี่ยน GOOGLE_REDIRECT_URI เป็นโดเมนจริง เช่น:
# https://your-project.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
